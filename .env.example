CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# ---------------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------------
# The single browser-facing origin. Used by api-backend and ws-gateway to
# validate the Origin header, to decide cookie attributes, and to resolve
# return_to targets. Scheme + host + port only; no path.
PUBLIC_ORIGIN=http://localhost:3000

# Development only. Requires PUBLIC_ORIGIN to be http://localhost,
# http://127.0.0.1 or http://[::1] — the services refuse to start otherwise.
# Switches cookies from __Host- prefixed and Secure to plain development names,
# because __Host- cookies cannot work over plain HTTP.
# Leave this OUT of any real deployment.
AUTH_INSECURE_DEV_COOKIES=1

# ---------------------------------------------------------------------------
# Access tokens (Ed25519 JWT)
# ---------------------------------------------------------------------------
# Generate the whole set with:
#     cd backend && cargo run -p api-backend -- gen-keys
#
# To rotate the signing key later use `gen-jwt-key --kid k2` instead — it
# leaves REFRESH_TOKEN_HMAC_KEY alone. See README.md for the rollout order.
JWT_ISSUER=http://localhost:3000   # `iss` claim; conventionally the public origin
JWT_AUDIENCE=hrmonitor-web         # `aud` claim
JWT_ACTIVE_KID=                    # kid used for signing (api-backend only)
JWT_PRIVATE_KEY=                   # base64 32-byte Ed25519 seed (api-backend only)
JWT_PUBLIC_KEYS=                   # JWK Set JSON; given to api-backend AND ws-gateway

# ---------------------------------------------------------------------------
# Refresh sessions (Redis)
# ---------------------------------------------------------------------------
# WARNING: changing REFRESH_TOKEN_HMAC_KEY invalidates every stored refresh
# session and logs out every user. Treat it as permanent for the life of the
# deployment.
REFRESH_TOKEN_HMAC_KEY=            # base64 32 bytes; hashes refresh tokens
# Encrypts the short-lived copy of a rotated token used to recover from a lost
# refresh response. Rotating this only disables that 10s recovery window.
REFRESH_SEAL_KEY=                  # base64 32 bytes

# ---------------------------------------------------------------------------
# Discord OAuth (login)
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=              # e.g. http://localhost:3000/api/auth/callback/discord
                                   # Must exactly match the redirect registered
                                   # in the Discord developer portal.

# ---------------------------------------------------------------------------
# Pulsoid OAuth (heart-rate source)
# ---------------------------------------------------------------------------
PULSOID_CLIENT_ID=
PULSOID_CLIENT_SECRET=
PULSOID_REDIRECT_URI=              # e.g. https://yourdomain.com/api/oauth/pulsoid/callback
TOKEN_ENCRYPTION_KEY=              # openssl rand -base64 32
